# 主问题默认使用桌面 AI，不需要单独填写生成模型 Key。
STORYCUE_PLAN_PROVIDER=desktop
# 实时语音与即时追问：填写使用者自己的服务 Key。
DOUBAO_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
RELAY_LLM_PROVIDER=openai
RELAY_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
RELAY_LLM_MODEL=doubao-seed-2-0-lite-260428
RELAY_LLM_API_KEY=
RELAY_LLM_THINKING=disabled
# Jev 默认关闭。无此服务时自动停顿接话，无需点按钮。
STORYCUE_JEV_ENABLED=0
TYPESAFE_API_KEY=
# 仅在用户自己明确配置时使用，不附带任何代理服务器。
TYPESAFE_PROXY_URL=
