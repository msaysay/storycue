# 主问题默认使用桌面 AI，不需要单独填写生成模型 Key。
STORYCUE_PLAN_PROVIDER=desktop
# 1. 豆包语音（听与说）：固定地址已内置，无需配置文本模型地址。
# ASR: wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# TTS: https://openspeech.bytedance.com/api/v3/tts/unidirectional
# 在火山引擎语音控制台创建 Key，开通识别与合成权限；不要填写方舟文本 Key。
DOUBAO_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# 2. 即时追问（文本推理与剪辑建议）：可使用其他服务商，与上面的语音独立。
# 协议为 OpenAI Chat Completions 兼容（Bearer/SSE/messages/temperature/max_tokens）。
# 下方地址仅为方舟示例；请把地址、Key、模型名一起换成自己的同一服务商配置。
RELAY_LLM_PROVIDER=openai
# 填 API Base URL，保留版本路径；不要加 /chat/completions，也不是控制台网址。
RELAY_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
RELAY_LLM_MODEL=doubao-seed-2-0-lite-260428
RELAY_LLM_API_KEY=
# auto 仅对内置方舟地址发送关闭深度思考参数，其他兼容服务不发送豆包专用参数。
# 不保证所有模型支持关闭思考；按服务商选择快速直出模型。
RELAY_LLM_THINKING=auto
# Jev 默认关闭。无此服务时自动停顿接话，无需点按钮。
STORYCUE_JEV_ENABLED=0
TYPESAFE_API_KEY=
# 仅在用户自己明确配置时使用，不附带任何代理服务器。
TYPESAFE_PROXY_URL=
